Useful SQL Searches
Search Staff
SQL
SELECT *
FROM staff
WHERE full_name LIKE ?
OR staff_number LIKE ?;
Search Flights
SQL
SELECT *
FROM flights
WHERE flight_number LIKE ?
OR destination LIKE ?;
Find Assignments For One Flight
SQL
SELECT s.*
FROM staff s
JOIN flight_assignments fa
ON s.staff_id = fa.staff_id
WHERE fa.flight_id = ?;
Find Flights For One Staff
SQL
SELECT f.*
FROM flights f
JOIN flight_assignments fa
ON f.flight_id = fa.flight_id
WHERE fa.staff_id = ?;
